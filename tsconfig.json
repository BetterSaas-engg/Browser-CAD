{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    /* Browser types only. Node's globals are deliberately absent: this code
       runs in a tab, and `process` or `Buffer` reaching for them by mistake
       should fail here rather than at runtime. The tests need Node, and get it
       from tsconfig.test.json. */
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* Everything that runs in Node rather than in a tab: the tests, and anything
     named *.node.ts — the test-only font loader and the dev-server AI endpoint.
     All of it is checked by tsconfig.test.json instead, which is the only place
     Node types live (D40). Excluding the endpoint here is also a second line of
     defence: a client file importing it would fail to type-check. */
  "exclude": ["src/**/*.test.ts", "src/**/*.node.ts"]
}
