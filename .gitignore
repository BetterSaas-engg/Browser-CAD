# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Where bundle.test.ts builds the app to check the API key is not in it. It
# cleans up after itself; this is for the run that gets interrupted.
dist-bundle-check

# Environment files. The *.local rule above already catches .env.local, which
# is the only one Vite's own template expects — but plain .env and .env.<mode>
# are not covered by it, and a secret committed to a public repo cannot be
# taken back by deleting it. An .env.example with dummy values is still fine.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code local permission overrides. settings.json is the shared
# project allowlist and is committed; this one records one-off approvals
# with local paths in them.
.claude/settings.local.json
